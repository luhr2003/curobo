  <!-- Right foot: merged ankle_pitch(0.074) + ankle_roll(0.608) = 0.682 kg -->
  <joint name="right_foot_joint" type="fixed">
    <origin xyz="0. 0.0000944 -0.30001" rpy="0. 0. 0."/>
    <parent link="right_knee_link"/>
    <child link="right_foot_link"/>
  </joint>
  <link name="right_foot_link">
    <inertial>
      <origin xyz="0.035 0. -0.03" rpy="0. 0. 0."/>
