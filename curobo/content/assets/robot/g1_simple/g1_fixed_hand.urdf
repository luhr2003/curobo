<?xml version="1.0" encoding="UTF-8"?>
<!--
  g1_simple.urdf
  Simplified version of g1.urdf (no mobile base):
    - Hand finger joints/links removed, merged into one sphere per hand (fixed to palm)
    - Hip pitch joint kept (revolute), hip roll/yaw merged into one box per leg (fixed to hip_pitch) 
    - Ankle joints removed, ankle links merged into one sphere per leg (fixed to knee)
    - Knee joint kept (revolute), with recomputed origin from merged upper leg
    - Waist chain fully preserved
    - Arm chain fully preserved
-->
<robot name="g1_29dof_with_hand_rev_1_0">

  <!-- ==================== PELVIS ==================== -->
  <link name="g1_29dof_with_hand_rev_1_0">
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/pelvis_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
  </link>

  <!-- Pelvis fixed joints -->
  <joint name="pelvis_contour_joint" type="fixed">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="g1_29dof_with_hand_rev_1_0"/>
    <child link="pelvis_contour_link"/>
  </joint>
  <link name="pelvis_contour_link">
    <inertial>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0." ixz="0." iyy="0.0000001" iyz="0." izz="0.0000001"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/pelvis_contour_link_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/pelvis_contour_link_collisions.obj" scale="1. 1. 1."/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_in_pelvis_joint" type="fixed">
    <origin xyz="0.04525 0. -0.08339" rpy="0. 0. 0."/>
    <parent link="g1_29dof_with_hand_rev_1_0"/>
    <child link="imu_in_pelvis"/>
  </joint>
  <link name="imu_in_pelvis">
    <inertial>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <mass value="0.000001"/>
      <inertia ixx="0.00001" ixy="0." ixz="0." iyy="0.00001" iyz="0." izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== WAIST CHAIN ==================== -->
  <joint name="waist_yaw_joint" type="revolute">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="g1_29dof_with_hand_rev_1_0"/>
    <child link="waist_yaw_link"/>
    <axis xyz="0. 0. 1."/>
    <limit lower="-1.618" upper="1.618" effort="88." velocity="32.0000004"/>
  </joint>
  <link name="waist_yaw_link">
    <inertial>
      <origin xyz="0.003494 0.000233 0.018034" rpy="0. 0. 0."/>
      <mass value="0.214"/>
      <inertia ixx="0.0001067" ixy="0.0000027" ixz="-0.0000076" iyy="0.0001042" iyz="-0.0000002" izz="0.0001625"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/waist_yaw_link_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
  </link>

  <joint name="waist_roll_joint" type="revolute">
    <origin xyz="-0.0039635 0. 0.044 " rpy="0. 0. 0."/>
    <parent link="waist_yaw_link"/>
    <child link="waist_roll_link"/>
    <axis xyz="1. 0. 0."/>
    <limit lower="-1.0" upper="1.0" effort="50" velocity="37.0"/>
  </joint>
  <link name="waist_roll_link">
    <inertial>
      <origin xyz="0. 0.000023 0. " rpy="0. 0. 0."/>
      <mass value="0.086"/>
      <inertia ixx="0.0000071" ixy="0." ixz="0." iyy="0.0000063" iyz="0." izz="0.0000082"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/waist_roll_link_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
  </link>

  <joint name="waist_pitch_joint" type="revolute">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="waist_roll_link"/>
    <child link="torso_link"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-1.5" upper="1.5" effort="50" velocity="37.0"/>
  </joint>
  <link name="torso_link">
    <inertial>
      <origin xyz="0.000931 0.000346 0.15082 " rpy="0. 0. 0."/>
      <mass value="6.7800002"/>
      <inertia ixx="0.05905" ixy="0.0000333" ixz="-0.0017715" iyy="0.047014" iyz="-0.0000224" izz="0.025652"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/torso_link_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/torso_link_collisions.obj" scale="1. 1. 1."/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== TORSO FIXED JOINTS ==================== -->
  <joint name="d435_joint" type="fixed">
    <origin xyz="0.0576235 0.01753 0.42987 " rpy="0. 0.8307768 0. "/>
    <parent link="torso_link"/>
    <child link="d435_link"/>
  </joint>
  <link name="d435_link">
    <inertial>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <mass value="0.000001"/>
      <inertia ixx="0.00001" ixy="0." ixz="0." iyy="0.00001" iyz="0." izz="0.00001"/>
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <origin xyz="0.0039635 0. -0.044 " rpy="0. 0. 0."/>
    <parent link="torso_link"/>
    <child link="head_link"/>
  </joint>
