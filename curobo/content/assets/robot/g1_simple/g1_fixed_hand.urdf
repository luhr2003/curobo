  <joint name="imu_in_torso_joint" type="fixed">
    <origin xyz="-0.03959 -0.00224 0.14792" rpy="0. 0. 0."/>
    <parent link="torso_link"/>
    <child link="imu_in_torso"/>
  </joint>
  <link name="imu_in_torso">
    <inertial>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <mass value="0.000001"/>
