    <axis xyz="0. 1. 0."/>
    <limit lower="-0.087267" upper="2.8797999" effort="139." velocity="20.000001"/>
  </joint>
  <!-- Right shin: box 0.08x0.08x0.22, centered at (0.005,0,-0.13) -->
  <link name="right_knee_link">
    <inertial>
      <origin xyz="0.005 0. -0.13" rpy="0. 0. 0."/>
      <mass value="1.932"/>
      <inertia ixx="0.00882" ixy="0." ixz="0." iyy="0.00882" iyz="0." izz="0.00206"/>
