  </link>

  <joint name="mid360_joint" type="fixed">
    <origin xyz="0.0002835 0.00003 0.41618 " rpy="0. 0.0401426 0. "/>
    <parent link="torso_link"/>
    <child link="mid360_link"/>
  </joint>
  <link name="mid360_link">
    <inertial>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <mass value="0.000001"/>
      <inertia ixx="0.00001" ixy="0." ixz="0." iyy="0.00001" iyz="0." izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== LEFT LEG (SIMPLIFIED) ==================== -->
  <!--
    Original chain: pelvis -> hip_pitch -> hip_roll -> hip_yaw -> knee -> ankle_pitch -> ankle_roll
    Simplified: pelvis -> [revolute] hip_pitch -> [fixed] upper_leg (box, merging hip_roll+hip_yaw)
                -> [revolute] knee -> [fixed] foot (sphere)
  -->
  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0. 0.064452 -0.1027" rpy="0. 0. 0."/>
    <parent link="g1_29dof_with_hand_rev_1_0"/>
    <child link="left_hip_pitch_link"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-2.5306997" upper="2.8797999" effort="88." velocity="32.0000004"/>
  </joint>
  <link name="left_hip_pitch_link">
    <inertial>
      <origin xyz="0.002741 0.047791 -0.02606" rpy="0. 0. 0."/>
      <mass value="1.35"/>
      <inertia ixx="0.001811" ixy="0.0000368" ixz="-0.0000344" iyy="0.0014193" iyz="0.000171" izz="0.0012812"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/left_hip_pitch_link_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/left_hip_pitch_link_collisions.obj" scale="1. 1. 1."/>
      </geometry>
    </collision>
  </link>

  <joint name="left_upper_leg_joint" type="fixed">
    <origin xyz="0. 0.052 -0.030465" rpy="0. -0.1749 0."/>
    <parent link="left_hip_pitch_link"/>
    <child link="left_upper_leg_link"/>
  </joint>
  <link name="left_upper_leg_link">
    <inertial>
      <!-- Combined mass: hip_roll(1.52) + hip_yaw(1.702) = 3.222 -->
      <origin xyz="0. 0. -0.15" rpy="0. 0. 0."/>
      <mass value="3.222"/>
      <inertia ixx="0.02084" ixy="0." ixz="0." iyy="0.02084" iyz="0." izz="0.00537"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. -0.15" rpy="0. 0. 0."/>
      <geometry>
        <box size="0.10 0.10 0.26"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0. 0. -0.15" rpy="0. 0. 0."/>
      <geometry>
        <box size="0.10 0.10 0.26"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_knee_joint" type="revolute">
    <!-- Composite transform from upper_leg_link (=hip_roll frame) through hip_yaw to knee -->
    <origin xyz="-0.053272 0.0021489 -0.30146" rpy="0. 0.1749 0."/>
    <parent link="left_upper_leg_link"/>
    <child link="left_knee_link"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="-0.087267" upper="2.8797999" effort="139." velocity="20.000001"/>
  </joint>
  <!-- Left shin: box 0.08x0.08x0.22, centered at (0.005,0,-0.13) -->
  <link name="left_knee_link">
    <inertial>
      <origin xyz="0.005 0. -0.13" rpy="0. 0. 0."/>
      <mass value="1.932"/>
      <inertia ixx="0.00882" ixy="0." ixz="0." iyy="0.00882" iyz="0." izz="0.00206"/>
    </inertial>
    <visual>
      <origin xyz="0.005 0. -0.13" rpy="0. 0. 0."/>
      <geometry>
        <box size="0.08 0.08 0.22"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.005 0. -0.13" rpy="0. 0. 0."/>
      <geometry>
        <box size="0.08 0.08 0.22"/>
      </geometry>
    </collision>
  </link>

  <!-- Left foot: merged ankle_pitch(0.074) + ankle_roll(0.608) = 0.682 kg -->
  <joint name="left_foot_joint" type="fixed">
    <origin xyz="0. -0.0000944 -0.30001" rpy="0. 0. 0."/>
    <parent link="left_knee_link"/>
