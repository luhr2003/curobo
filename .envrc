#!/usr/bin/env bash
# Auto-activate the uv-managed .venv for this project.
# Run `direnv allow` once after creating or editing this file.

if [[ ! -d .venv ]]; then
    log_error ".venv not found. Create it with: uv venv --python 3.11"
    return 1
fi

# direnv-idiomatic activation: set VIRTUAL_ENV and prepend PATH,
# instead of sourcing .venv/bin/activate (which assumes a specific shell).
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Make sure uv and pip operate on this venv even if UV_PROJECT_ENVIRONMENT
# or PIP_* are set globally.
export UV_PROJECT_ENVIRONMENT="$VIRTUAL_ENV"

# Isaac Sim caches Omniverse extensions under $HOME by default. Pin them to
# the project directory so the cache is self-contained and easy to wipe.
# Comment these out if you prefer the global ~/.cache/ov location.
export OMNI_KIT_CACHE_DIR="$PWD/.cache/ov"
export OMNI_USER_PATH="$PWD/.cache/ov/user"

# Optional local overrides (not tracked in git).
[[ -f .envrc.local ]] && source_env .envrc.local
